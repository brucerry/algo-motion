{
    "name": "algorithm-motion",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --pretty false",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "format": "prettier --write src e2e *.ts *.json .prettierrc.json index.html README.md .github/workflows/*.yml",
        "format:check": "prettier --check src e2e *.ts *.json .prettierrc.json index.html README.md .github/workflows/*.yml"
    },
    "dependencies": {
        "@fontsource/patrick-hand": "^5.3.0",
        "@react-three/drei": "^10.7.8",
        "@react-three/fiber": "^9.8.0",
        "katex": "^0.18.9",
        "lucide-react": "^1.48.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "three": "^0.186.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/katex": "^0.16.8",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^6.1.1",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    }
}
